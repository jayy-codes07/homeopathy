# Copy to .env and fill in real values. Never commit .env.
MONGODB_URI=mongodb://localhost:27017/homeopathy
PORT=8000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

ACCESS_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRE=1d
REFRESH_TOKEN_SECRET=change-me-too
REFRESH_TOKEN_EXPIRE=10d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET=

# Optional. Leave empty to disable caching (requests go straight to MongoDB).
# Local Docker: redis://localhost:6379   Hosted (Upstash): rediss://default:<password>@<host>:6379
REDIS_URL=
# Tests and debugging only: redis | memory | none. Unset = redis when REDIS_URL is set, else none.
# CACHE_DRIVER=
